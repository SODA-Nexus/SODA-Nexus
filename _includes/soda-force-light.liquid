<meta name="color-scheme" content="light" />
<script>
  // The mockups these pages are built from have no dark-mode design, so we
  // pin the site's theme.js (assets/js/theme.js) to "light" here, after
  // head.liquid's own theme script has already run. That script sets
  // html[data-theme] from localStorage/system preference before first
  // paint; overriding it synchronously, later in the same <head>, is what
  // keeps al_folio_core's [data-theme="dark"] styles (which recolor text
  // for a dark background we don't have) from ever applying on these pages.
  document.documentElement.setAttribute("data-theme", "light");
</script>
