<div class="soda-nav">
  <div class="soda-bug-drift"><div class="soda-bug-mask"></div></div>
  <div class="soda-wrap">
    <a href="{{ '/' | relative_url }}" class="soda-brand">
      <img class="soda-mark" src="{{ '/assets/img/soda-logo.png' | relative_url }}" alt="Software Debugging and Analysis Nexus logo">
      <div class="soda-name">Software Debugging and Analysis Nexus @ UofA</div>
    </a>
    <button
      type="button"
      class="soda-nav-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="soda-nav-links"
    >
      <span class="soda-nav-toggle-bar"></span>
      <span class="soda-nav-toggle-bar"></span>
      <span class="soda-nav-toggle-bar"></span>
    </button>
    <ul id="soda-nav-links">
      <li>
        <a
          href="{{ '/' | relative_url }}"
          {% if page.url == '/' %}
            class="soda-active"
          {% endif %}
          >Home</a
        >
      </li>
      <li>
        <a
          href="{{ '/about/' | relative_url }}"
          {% if page.url == '/about/' %}
            class="soda-active"
          {% endif %}
          >About</a
        >
      </li>
      <li>
        <a
          href="{{ '/team/' | relative_url }}"
          {% if page.url == '/team/' or page.collection == 'people' %}
            class="soda-active"
          {% endif %}
          >Team</a
        >
      </li>
      <li>
        <a
          href="{{ '/news/' | relative_url }}"
          {% if page.url == '/news/' %}
            class="soda-active"
          {% endif %}
          >News</a
        >
      </li>
      <li>
        <a
          href="{{ '/publications/' | relative_url }}"
          {% if page.url == '/publications/' %}
            class="soda-active"
          {% endif %}
          >Publications</a
        >
      </li>
      <li>
        <a
          href="{{ '/join/' | relative_url }}"
          {% if page.url == '/join/' %}
            class="soda-active"
          {% endif %}
          >Join</a
        >
      </li>
    </ul>
    <button type="button" class="soda-theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
      <span class="soda-theme-icon-light" aria-hidden="true">🌙</span>
      <span class="soda-theme-icon-dark" aria-hidden="true">☀️</span>
    </button>
  </div>
  <script>
    (function () {
      // Owns the "soda-theme" localStorage key that soda-theme-init.liquid's
      // early head script reads on every subsequent page load — that script
      // sets html[data-theme] before paint, this one only has to keep the
      // button's own icon/aria state in sync with whatever it already set.
      var toggleBtn = document.querySelector('.soda-theme-toggle');
      if (toggleBtn) {
        var root = document.documentElement;

        function reflect(theme) {
          var isDark = theme === 'dark';
          toggleBtn.classList.toggle('soda-theme-is-dark', isDark);
          toggleBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          toggleBtn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        }

        reflect(root.getAttribute('data-theme'));

        toggleBtn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          reflect(next);
          try {
            localStorage.setItem('soda-theme', next);
          } catch (e) {}
        });
      }
    })();
    (function () {
      var nav = document.querySelector('.soda-nav');
      if (!nav) return;
      var toggle = nav.querySelector('.soda-nav-toggle');
      var links = document.getElementById('soda-nav-links');
      if (!toggle || !links) return;

      function setOpen(open) {
        nav.classList.toggle('soda-nav-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      toggle.addEventListener('click', function () {
        setOpen(!nav.classList.contains('soda-nav-open'));
      });

      links.addEventListener('click', function (event) {
        if (event.target.closest('a')) {
          setOpen(false);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && nav.classList.contains('soda-nav-open')) {
          setOpen(false);
          toggle.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 768 && nav.classList.contains('soda-nav-open')) {
          setOpen(false);
        }
      });
    })();
  </script>
</div>
