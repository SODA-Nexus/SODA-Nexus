---
---
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    {% include soda-fonts.liquid %}
    {% include soda-force-light.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/soda-lab.css' | relative_url }}" />
  </head>
  <body class="soda-page">
    {% include soda-nav.liquid %}

    <div class="soda-page-head">
      <div class="soda-wrap">
        <p class="soda-eyebrow">{{ page.eyebrow }}</p>
        <h1>{{ page.title }}</h1>
        <hr class="soda-rule" />
        <p class="soda-sub">{{ page.subtitle }}</p>
      </div>
    </div>

    <section class="soda-section">
      <div class="soda-wrap">
        <p class="soda-label">Who we're looking for</p>
        <div class="soda-grid-4">
          {% for track in page.tracks %}
            <div class="soda-card soda-track-card">
              <span class="soda-tag soda-track-tag">{{ track.tag }}</span>
              <h3>{{ track.title }}</h3>
              <p>{{ track.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="soda-section">
      <div class="soda-wrap">
        <div class="soda-section-head"><div class="soda-bar"></div><h2>How to apply</h2></div>
        <p class="soda-sub soda-apply-intro">Email us a short note about your background, research interests, and why you want to join the lab. Attach a resume or CV if you have one.</p>

        <div class="soda-apply-panel">
          <div class="soda-apply-body soda-apply-cta">
            <a class="soda-btn soda-solid" href="mailto:{{ page.contact_email }}">Email {{ page.contact_email }}</a>
            <p class="soda-fine-print">We read every message and typically respond within two weeks.</p>
          </div>
        </div>
      </div>
    </section>

    {% include soda-footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
