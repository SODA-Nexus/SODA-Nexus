---
---
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    {% include soda-fonts.liquid %}
    {% include soda-theme-init.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/soda-lab.css' | relative_url }}">
  </head>
  <body class="soda-page">
    {% include soda-nav.liquid %}

    <main class="soda-content">
      <div class="soda-page-head">
        <div class="soda-wrap">
          <p class="soda-eyebrow">{{ page.eyebrow }}</p>
          <h1>{{ page.title }}</h1>
          <hr class="soda-rule">
          <p class="soda-sub">{{ page.subtitle }}</p>
        </div>
      </div>

      <section class="soda-section">
        <div class="soda-wrap">
          {% assign years = site.publications | map: 'year' | uniq | sort | reverse %}
          {% if site.publications.size == 0 %}
            <p class="soda-empty-state">Publications are being added — check back soon.</p>
          {% else %}
            {% assign keyword_pool = '' %}
            {% for pub in site.publications %}
              {% for kw in pub.keywords %}
                {% assign keyword_pool = keyword_pool | append: kw | append: '|' %}
              {% endfor %}
            {% endfor %}
            {% assign all_keywords = keyword_pool | split: '|' | uniq | sort %}

            {% assign author_slug_pool = '|' %}
            {% for pub in site.publications %}
              {% for author in pub.authors %}
                {% if author.slug %}
                  {% assign author_slug_pool = author_slug_pool | append: author.slug | append: '|' %}
                {% endif %}
              {% endfor %}
            {% endfor %}
            {% assign contributing_people = site.people | sort: 'name' %}

            <div class="soda-pub-search">
              <input
                type="text"
                id="soda-pub-search-input"
                class="soda-search-input"
                placeholder="Search publications by title, author, or venue…"
                autocomplete="off"
              >
              <div class="soda-filter-row">
                <div class="soda-filter-field">
                  <label for="soda-filter-person">Person</label>
                  <select id="soda-filter-person" class="soda-filter-select">
                    <option value="">All People</option>
                    {% for person in contributing_people %}
                      {% assign person_needle = person.slug | prepend: '|' | append: '|' %}
                      {% if author_slug_pool contains person_needle %}
                        <option value="{{ person.slug }}">{{ person.name }}</option>
                      {% endif %}
                    {% endfor %}
                  </select>
                </div>
                <div class="soda-filter-field">
                  <label for="soda-filter-field">Field</label>
                  <select id="soda-filter-field" class="soda-filter-select">
                    <option value="">All Fields</option>
                    {% for kw in all_keywords %}
                      <option value="{{ kw }}">{{ kw }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="soda-filter-field">
                  <label for="soda-filter-year">Year</label>
                  <select id="soda-filter-year" class="soda-filter-select">
                    <option value="">All Years</option>
                    {% for year in years %}
                      <option value="{{ year }}">{{ year }}</option>
                    {% endfor %}
                  </select>
                </div>
                <button type="button" class="soda-filter-clear" id="soda-filter-clear">Clear all filters</button>
              </div>
              <p class="soda-filter-count" id="soda-filter-count">Showing all {{ site.publications.size }} publications</p>
            </div>
            <p class="soda-empty-state soda-no-results" id="soda-no-results" hidden>No publications match your search.</p>
          {% endif %}
          {% for year in years %}
            {% assign pubs = site.publications | where: 'year', year | sort: 'order' %}
            <div class="soda-year-block" data-year-block>
              <div class="soda-year-head">
                <div class="soda-num">{{ year }}</div>
                <div class="soda-count" data-year-count>
                  {{ pubs.size }} paper{% unless pubs.size == 1 %}s{% endunless %}
                </div>
                <div class="soda-rule2"></div>
              </div>

              {% for pub in pubs %}
                <div
                  class="soda-pub"
                  data-pub
                  data-kw="{{ pub.keywords | join: '|' }}"
                  data-year="{{ pub.year }}"
                  data-authors="{{ pub.authors | map: 'slug' | join: ',' }}"
                >
                  <div class="soda-thumb{% if pub.image %} soda-thumb-photo{% endif %}">
                    {% if pub.image %}
                      <img src="{{ pub.image | relative_url }}" alt="{{ pub.title }}" loading="lazy">
                    {% else %}
                      <div class="soda-tl1"></div>
                      <div class="soda-tl2"></div>
                      <div class="soda-ln"></div>
                      <div class="soda-ln"></div>
                      <div class="soda-ln"></div>
                      <div class="soda-ln"></div>
                      <div class="soda-ln soda-colbreak"></div>
                      <div class="soda-ln"></div>
                      <div class="soda-ln"></div>
                    {% endif %}
                    <div class="soda-tag">PDF</div>
                  </div>
                  <div class="soda-pub-body">
                    <h3>{{ pub.title }}</h3>
                    <div class="soda-venue">{{ pub.venue }}</div>
                    <div class="soda-authors">
                      {% for author in pub.authors %}
                        {% if author.slug %}
                          <a href="{{ '/people/' | append: author.slug | append: '/' | relative_url }}">{{ author.name }}</a>
                        {% else %}
                          <span class="soda-ext">{{ author.name }}</span>
                        {% endif -%}
                        {%- unless forloop.last -%}
                          ,
                        {% endunless %}
                      {% endfor %}
                    </div>
                    {% assign pdf_available = false %}
                    {% if pub.pdf_url and pub.pdf_url != '#' %}
                      {% assign pdf_href = pub.pdf_url | relative_url %}
                      {% assign pdf_available = true %}
                    {% endif %}
                    <div class="soda-pub-actions">
                      {% if pdf_available %}
                        <a class="soda-dl" href="{{ pdf_href }}">⬇ Download PDF</a>
                      {% else %}
                        <span class="soda-dl soda-dl-disabled" aria-disabled="true">N/A</span>
                      {% endif %}
                    </div>
                    <details>
                      <summary>Abstract</summary>
                      <p class="soda-abstract">{{ pub.abstract }}</p>
                    </details>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </section>
    </main>

    {% include soda-footer.liquid %}
    {% include scripts.liquid %}
    {% if site.publications.size > 0 %}
      <script>
        (function () {
          var searchInput = document.getElementById('soda-pub-search-input');
          var personSelect = document.getElementById('soda-filter-person');
          var fieldSelect = document.getElementById('soda-filter-field');
          var yearSelect = document.getElementById('soda-filter-year');
          var clearBtn = document.getElementById('soda-filter-clear');
          var yearBlocks = Array.prototype.slice.call(document.querySelectorAll('[data-year-block]'));
          var allPubs = Array.prototype.slice.call(document.querySelectorAll('[data-pub]'));
          var noResults = document.getElementById('soda-no-results');
          var countEl = document.getElementById('soda-filter-count');
          var totalPubs = allPubs.length;

          function pubText(pub) {
            return pub.textContent.toLowerCase();
          }

          function pubKeywords(pub) {
            return (pub.getAttribute('data-kw') || '').split('|');
          }

          function pubAuthors(pub) {
            return (pub.getAttribute('data-authors') || '').split(',');
          }

          function applyFilters() {
            var query = searchInput.value.trim().toLowerCase();
            var person = personSelect.value;
            var field = fieldSelect.value;
            var year = yearSelect.value;
            var visibleTotal = 0;

            yearBlocks.forEach(function (block) {
              var visibleInYear = 0;
              var blockPubs = Array.prototype.slice.call(block.querySelectorAll('[data-pub]'));

              blockPubs.forEach(function (pub) {
                var matchesQuery = query === '' || pubText(pub).indexOf(query) !== -1;
                var matchesField = field === '' || pubKeywords(pub).indexOf(field) !== -1;
                var matchesPerson = person === '' || pubAuthors(pub).indexOf(person) !== -1;
                var matchesYear = year === '' || pub.getAttribute('data-year') === year;
                var visible = matchesQuery && matchesField && matchesPerson && matchesYear;

                pub.style.display = visible ? '' : 'none';
                if (visible) {
                  visibleInYear += 1;
                }
              });

              block.hidden = visibleInYear === 0;
              var yearCountEl = block.querySelector('[data-year-count]');
              if (yearCountEl) {
                yearCountEl.textContent = visibleInYear + ' paper' + (visibleInYear === 1 ? '' : 's');
              }
              visibleTotal += visibleInYear;
            });

            noResults.hidden = visibleTotal !== 0;
            countEl.textContent =
              visibleTotal === totalPubs
                ? 'Showing all ' + totalPubs + ' publications'
                : 'Showing ' + visibleTotal + ' of ' + totalPubs + ' publications';
          }

          searchInput.addEventListener('input', applyFilters);
          personSelect.addEventListener('change', applyFilters);
          fieldSelect.addEventListener('change', applyFilters);
          yearSelect.addEventListener('change', applyFilters);

          clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            personSelect.value = '';
            fieldSelect.value = '';
            yearSelect.value = '';
            applyFilters();
          });
        })();
      </script>
    {% endif %}
  </body>
</html>
