---
---
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    {% include soda-fonts.liquid %}
    {% include soda-theme-init.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/soda-lab.css' | relative_url }}">
  </head>
  <body class="soda-page">
    {% include soda-nav.liquid %}

    <main class="soda-content">
      <div class="soda-page-head">
        <div class="soda-wrap">
          <p class="soda-eyebrow">{{ page.eyebrow }}</p>
          <h1>{{ page.title }}</h1>
          <hr class="soda-rule">
          <p class="soda-sub">{{ page.subtitle }}</p>
        </div>
      </div>

      <section class="soda-section soda-tone-a">
        <div class="soda-wrap soda-mission-grid">
          <div>
            <div class="soda-section-head">
              <div class="soda-bar"></div>
              <div>
                <p class="soda-kicker">Overview</p>
                <h2>Our mission</h2>
              </div>
            </div>
            {{ content }}
          </div>
          <div class="soda-stat-card">
            {% for stat in page.stats %}
              <div class="soda-stat-row">
                <div class="soda-n">{{ stat.n }}</div>
                <div class="soda-l">{{ stat.l }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="soda-section soda-tone-b">
        <div class="soda-wrap">
          <div class="soda-section-head">
            <div class="soda-bar"></div>
            <div>
              <p class="soda-kicker">Our principles</p>
              <h2>What we value</h2>
            </div>
          </div>
          <div class="soda-grid-3">
            {% for value in page.values %}
              <div class="soda-value-card">
                <h3>{{ value.title }}</h3>
                <p>{{ value.description }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="soda-section soda-tone-a">
        <div class="soda-wrap">
          <div class="soda-section-head">
            <div class="soda-bar"></div>
            <div>
              <p class="soda-kicker">Location</p>
              <h2>Visit us</h2>
            </div>
          </div>
          <div class="soda-loc-grid">
            <div class="soda-map-box">
              {% if page.map_query %}
                <iframe
                  src="https://www.google.com/maps?q={{ page.map_query | url_encode }}&output=embed"
                  width="100%"
                  height="100%"
                  style="border: 0"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Map of {{ page.map_query }}"
                ></iframe>
              {% endif %}
            </div>
            <div class="soda-addr">
              {% for line in page.address %}
                <p>{{ line | al_email_protect_html }}</p>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>
    </main>

    {% include soda-footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
