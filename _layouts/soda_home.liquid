---
---
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    {% include soda-fonts.liquid %}
    {% include soda-force-light.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/soda-lab.css' | relative_url }}">
  </head>
  <body class="soda-page">
    {% include soda-nav.liquid %}

    <main class="soda-content">
      <section class="soda-hero">
        <div class="soda-wrap soda-hero-grid">
          <div>
            <p class="soda-eyebrow">{{ page.eyebrow }}</p>
            <h1>{{ page.title }}</h1>
            <hr class="soda-rule">
            {{ content }}
            <div class="soda-cta-row">
              {% for cta in page.cta %}
                <a class="soda-btn {{ cta.style }}" href="{{ cta.url | relative_url }}">{{ cta.label }}</a>
              {% endfor %}
            </div>
          </div>
          <div class="soda-side-card">
            <div class="soda-side-photo"></div>
            <div class="soda-side-info">
              {% for row in page.side_info %}
                <div class="soda-row">
                  <div class="soda-dot"></div>
                  <div>{{ row | al_email_protect_html }}</div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>

      <section class="soda-section">
        <div class="soda-wrap">
          <div class="soda-section-head">
            <div class="soda-bar"></div>
            <h2>What we work on</h2>
          </div>
          <div class="soda-grid-4">
            {% for area in page.research_areas %}
              <div class="soda-card">
                <div class="soda-icon">{{ area.icon }}</div>
                <h3>{{ area.title }}</h3>
                <p>{{ area.description }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="soda-section">
        <div class="soda-wrap soda-split">
          <div>
            <div class="soda-section-head">
              <div class="soda-bar"></div>
              <h2>Our approach</h2>
            </div>
            <ul class="soda-check">
              {% for item in page.approach %}
                <li>
                  <b>{{ item.title }}</b> — {{ item.description }}
                </li>
              {% endfor %}
            </ul>
          </div>
          <div id="soda-work-with-us">
            <div class="soda-section-head">
              <div class="soda-bar"></div>
              <h2>Work with us</h2>
            </div>
            {% for tile in page.work_with_us %}
              <div class="soda-contact-tile">
                <div class="soda-icn">{{ tile.icon }}</div>
                <p>
                  <b>{{ tile.title }}:</b> {{ tile.description }}
                </p>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="soda-section" style="background: var(--soda-panel)">
        <div class="soda-wrap soda-split-2">
          <div>
            <div class="soda-section-head">
              <div class="soda-bar"></div>
              <h2>Latest news</h2>
            </div>
            {% assign latest_news = site.news | sort: 'date' | reverse | slice: 0, 3 %}
            {% if latest_news.size == 0 %}
              <p class="soda-empty-state">News is being added — check back soon.</p>
            {% else %}
              {% for item in latest_news %}
                <div class="soda-list-item">
                  <div>
                    <div class="soda-t">{{ item.title }}</div>
                    <div class="soda-d">{{ item.date | date: '%b %-d, %Y' }}</div>
                  </div>
                  <span class="soda-news-chip soda-news-chip-sm" data-category="{{ item.category }}">{{ item.category }}</span>
                </div>
              {% endfor %}
            {% endif %}
            <p style="margin-top: 14px"><a class="soda-view-all" href="{{ '/news/' | relative_url }}">View all news →</a></p>
          </div>
          <div>
            <div class="soda-section-head">
              <div class="soda-bar"></div>
              <h2>Featured publications</h2>
            </div>
            {% assign latest_year = site.publications | map: 'year' | uniq | sort | last %}
            {% assign featured_pubs = site.publications | where: 'year', latest_year | sort: 'order' | slice: 0, 3 %}
            {% for pub in featured_pubs %}
              <div class="soda-pub-card">
                <div class="soda-pub-thumb">
                  {% if pub.image %}
                    <img src="{{ pub.image | relative_url }}" alt="{{ pub.title }}" loading="lazy">
                  {% endif %}
                </div>
                <div>
                  <h4>{{ pub.title }}</h4>
                  <div class="soda-venue">{{ pub.venue }}</div>
                  <p>{{ pub.authors | map: 'name' | join: ', ' }}</p>
                </div>
              </div>
            {% endfor %}
            <p style="margin-top: 14px">
              <a class="soda-view-all" href="{{ '/publications/' | relative_url }}">View all publications →</a>
            </p>
          </div>
        </div>
      </section>
    </main>

    {% include soda-footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
